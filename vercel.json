{
  "outputDirectory": "dashboard",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://app.firefunnels.net https://app.gohighlevel.com https://*.leadconnectorhq.com https://*.gohighlevel.com"
        }
      ]
    }
  ]
}
