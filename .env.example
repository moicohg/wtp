# Secrets de las Edge Functions (configurar con: supabase secrets set --env-file .env)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Canal Evolution API (whatsapp-handler)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# Canal Meta WhatsApp Business Cloud API (meta-webhook, meta-exchange)
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
# Opcional: enforce rechaza los webhooks de Meta con firma inválida (confirmar antes en logs que META_APP_SECRET es el correcto)
META_SIGNATURE_MODE=
# PIN de 6 dígitos para registrar en Cloud API los números conectados con "Continuar con Facebook"
META_REGISTER_PIN=

# Secreto compartido entre pg_cron y purge-media (el mismo valor va en Vault como cron_secret)
CRON_SECRET=
DELETE_ORG_PIN=
